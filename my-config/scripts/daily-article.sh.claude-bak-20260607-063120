#!/bin/bash
# 每日文章自动创作 + 推送
# launchd 每天 12:00 触发。基于当日 GetNote 笔记,用 xiaolai-write 创作一篇,push 到 Tony-Articles。
set -uo pipefail
# --- 共享互斥锁:daily-article 与 daily-ai-news 都调用 Claude session,排队避免并发抢占 ---
CLAUDE_SESSION_LOCK="/tmp/daily-claude-session.lock"
_waited=0
while ! mkdir "$CLAUDE_SESSION_LOCK" 2>/dev/null; do
  _waited=$((_waited+30))
  [ "$_waited" -gt 1800 ] && { echo "[lock] waited 30min, proceeding anyway" >&2; break; }
  sleep 30
done
trap 'rmdir "$CLAUDE_SESSION_LOCK" 2>/dev/null' EXIT
# --- 锁结束 ---

WORK="$HOME/.local/share/tony-articles"
CLAUDE="$HOME/.local/bin/claude"
LOG="$HOME/.claude/logs/daily-article.log"
TODAY="$(date +%Y-%m-%d)"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG"; }

log "===== 开始每日文章任务 $TODAY ====="

# 1. 同步仓库
cd "$WORK" || { log "FATAL: 工作目录不存在 $WORK"; exit 1; }
# 确保 .gitignore 含运行时垃圾(gbrain 在 cwd 反复生成 ruvector.db)
cat > .gitignore <<'GI'
.DS_Store
.omc/
*.log
ruvector.db
*.db
.tools/__pycache__/
GI
# 彻底清运行时产物: 从 index 移除 + 删文件 + 提交移除, 让 working tree 对 pull 干净
git rm -r --cached --ignore-unmatch ruvector.db "*.db" ".omc" >/dev/null 2>&1 || true
rm -f ruvector.db ./*.db 2>/dev/null || true
rm -rf .omc 2>/dev/null || true
# 提交 .gitignore + 移除(若有变化), 使 working tree clean
if [ -n "$(git status --porcelain)" ]; then
  git add -A 2>/dev/null
  git commit -q -m "chore: ignore 运行时产物 (auto)" 2>>"$LOG" || true
fi
for i in 1 2 3; do
  # 失败兜底: 第 3 次用 reset --hard 强制对齐远端(文章已在 articles/ 且会被 commit, 不丢稿)
  if git pull -q --rebase origin main 2>>"$LOG"; then break; fi
  log "git pull 第 $i 次失败, 重试..."
  rm -f ruvector.db ./*.db 2>/dev/null
  [ "$i" -eq 3 ] && { git rebase --abort 2>/dev/null; git fetch -q origin main && git reset --hard origin/main 2>>"$LOG" && log "  已 reset --hard 对齐远端"; }
  sleep $((i*3))
done

# 2. 幂等:今天已成功生成过就跳过(防 launchd 重复/重试触发)
#    成功标志 = 完成标记文件存在, 或 en+zh 两版都已落地
if [ -f "$HOME/.claude/logs/.daily-article-done-${TODAY}" ] || \
   { ls articles/en/${TODAY}-*.md >/dev/null 2>&1 && ls articles/zh/${TODAY}-*.md >/dev/null 2>&1; }; then
  log "今日中英双版已完成, 跳过"
  exit 0
fi
# 防止多个实例并发(launchd 重试时上一次可能还在跑)
LOCK="$HOME/.claude/logs/.daily-article.lock"
if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then
  log "上一次任务仍在运行 (PID $(cat "$LOCK")), 本次跳过"
  exit 0
fi
echo $$ > "$LOCK"
# 追加 trap(不覆盖共享锁 trap),确保两个锁都释放
trap 'rm -f "$LOCK"; rmdir "$CLAUDE_SESSION_LOCK" 2>/dev/null' EXIT
mkdir -p articles/en articles/zh

# 已发布主题持久 log(append-only,文章被删也不丢,供选题去重防重发)
# 首次运行从全部历史标题 bootstrap:articles/ 根(452 篇老历史)+ en + zh,去重
PUB_LOG=".tools/published-topics.log"
if [ ! -f "$PUB_LOG" ]; then
  for f in articles/*.md articles/en/*.md articles/zh/*.md; do
    [ -f "$f" ] && head -1 "$f" | sed 's/^#[[:space:]]*//'
  done 2>/dev/null | sed '/^[[:space:]]*$/d' | sort -u > "$PUB_LOG"
  log "bootstrap published-topics.log: $(wc -l < "$PUB_LOG" 2>/dev/null | tr -d ' ') 条历史主题(全量)"
fi

# 3. 调 Claude Code 非交互完成全流程(中英双版)
PROMPT=$(cat <<'PROMPT_EOF'
你是盛大白(Tony)本人的写作助手。今天的任务:基于我今天的 GetNote 笔记,用 xiaolai-write 完整 pipeline 创作一篇文章,并产出【中文版 + 英文版】两个版本,发布到 Tony-Articles 仓库。

严格按以下步骤执行,全程 zero-pause,不要中途停下问我任何问题:

【第零步:判断是续跑半成品还是开新题】
先 ls ~/.local/share/tony-articles/articles/en/ 和 articles/zh/, 记下"已发布"的所有 slug / 中文标题。

然后运行 /plan-list-articles 查看 ~/Desktop/内容创作/01-文章加工厂/ 里的所有项目。判定规则(严格):

**判定为"已发布,不再续"**的项目同时满足任一:
- .state.json 里 current_phase 是 "complete" 或 "done"
- 它的 slug 对应的文件已经出现在 articles/en/ 里(任意日期)
- 它的主题在 articles/zh/ 已有同义的中文标题

**判定为"未完成,值得续"**的项目同时满足:
- current_phase 不是 complete / done(数字 0-11 或 2a/2b/2c)
- articles/en/ 和 articles/zh/ 里【都没有】这个 slug 或同义标题的文件
- 也就是说: 它还没真正发布过

操作:
- 如果有"未完成且未发布"的项目 → /plan-switch-article <那个 slug>, 跳到第三步把它续跑完。
- 如果没有(所有未完成项目都已发布过) → 走第一、二步开**全新**选题。
- **绝不要**对已发布过的文章再跑一遍, 哪怕 state 显示阶段未满。重复发布同主题是严重错误。

【第一步:取素材】
调用 GetNote 工具读取我最近的笔记:
- 先用 mcp__getnote__list_notes (since_id=0) 取最近 20 条笔记
- 再针对其中的关键主题用 mcp__getnote__recall 做语义召回, 补充相关历史笔记
- 若 GetNote 返回 502/超时, 重试最多 3 次(间隔几秒); 仍失败则记录原因后退出, 不要硬编造内容

【第二步:选题——价值观过滤】
从笔记里捕捉「有独特价值、能引发思考、与我(Tony)相关」的内容点。我的价值理念主线(选题必须贴合其一):
- 跨时空连接:把不同领域/时代/学科的东西连起来产生新意
- 工程化破界:用系统化、工程化的方法突破个人能力边界
- 自进化系统:让人和系统持续自我迭代、复利成长
- "第零阶级" / 用 AI 让人变强而非变懒:借助 AI 主动进化,而不是用 AI 偷懒
- 终身学习、长期主义、践行导向(受李笑来影响)
只选 1 个最有张力的点。
**选定后必须去重**:读 ~/.local/share/tony-articles/.tools/published-topics.log(每行一个历史已发布主题,**含已从仓库删除的旧文**)。若你选的主题与其中任一同义/高度重复,换一个未写过的点;若所有贴合理念的点都已写过,记录"今日无新选题"到日志后退出(exit 0)。**重发(哪怕是已删除的)旧主题是严重错误。**
若今天笔记里没有任何贴合上述理念、值得写的点,就不要硬写——记录"今日无合适选题"到日志后退出(exit 0)。

【隐私与脱敏铁律(最高优先级,凌驾选题与创作)】
笔记是我的私人素材,文章是公开发布到 GitHub。从笔记提炼时,严禁把以下私密信息写进文章正文:
- **真实人名一律不出现**:学员、客户、家人、朋友、同事、合作方的姓名(含化名/昵称)。需举例就用"一位学员""有位朋友""有人"等泛指,绝不带具体名字。
- **中文教学业务信息**:学员名单/数据、上课与排课安排、课程具体内容、收费/报价/营收、招生与运营细节、机构或平台名称——这些是经营隐私,不写进公开文章。
- **个人隐私**:真实姓名(用笔名盛大白)、家庭、住址、行程、联系方式、收入/财务、健康状况。
- **敏感话题**:政治、宗教、涉及他人的未公开隐私、容易引发争议的个人立场——不碰。
- **技术敏感信息**:API key、token、服务器 IP、内部路径、私有项目代号。
做法:只提炼【可公开的抽象观点、方法论、成长/学习/AI 思考】,把私密载体抽象成普适道理(例:"我有个学员张三月入十万"→"我见过有人靠这个方法显著改变处境")。
**若某个选题点离开这些私密细节就立不住,放弃它,换一个纯靠公开观点就能支撑的点。** 宁可"今日无合适选题"退出,也不发含隐私的文章。

【第三步:创作(xiaolai-write 完整 pipeline,中英双版)】
用 /xiaolai-write skill 完整创作这篇文章,走它的完整 pipeline。
- xiaolai-write 原生流程:英文创作 → Phase 9 /plan-translate 翻译成中文。两版都要产出。
- **关键(避免卡死):research / fact-check 等阶段【不要派发 subagent】,在主会话里直接用 WebSearch / getnote / 已有 research 文件快速完成。派 subagent 在非交互模式会挂起。**
- 目标读者:关注成长、学习、AI、自我进化的普通人,中文版用盛大白真诚、口语化、有温度的公众号风格。
- 长度:正文 1500-3000 字(英文对应 1000-2000 词)。
- 最终你手上要有:英文成品 + 中文成品,两版内容一一对应。

【第四步:保存双版 + 发布】
今天的日期记为 TODAY(格式 YYYY-MM-DD),取一个简洁的英文 slug(小写连字符,去特殊字符)。
- 英文版保存到: articles/en/TODAY-<slug>.md
- 中文版保存到: articles/zh/TODAY-<中文标题>.md (中文标题去掉 / : 等特殊字符)
两个文件开头都加:
  # 标题

  > 发布日期:TODAY · [中文](../zh/...) | [English](../en/...)

  ---
(互相链接到对方语言版本)
- 重新生成 README.md:在仓库根目录运行 python3 .tools/gen_readme.py (它会自动扫描 articles/en 和 articles/zh 重建索引)
- git add -A && git commit -m "post: <slug> 中英双版 (TODAY)" && git push origin main

完成后用一句话报告:文章标题(中/英)+ 两版是否都已推送成功。
PROMPT_EOF
)

# xiaolai-write 工作区根(每个 slug 一个子目录)
FACTORY="$HOME/Desktop/内容创作/01-文章加工厂"

# 找到"今天这轮"的 xiaolai-write 项目 state
# 优先级: 1) 最近 4 小时内修改过 + phase 不是 complete/done 的项目
#        2) 退化用最新一个(供日志显示用)
latest_state() {
  python3 << 'PY' 2>/dev/null
import json, os, glob, time
factory = os.path.expanduser("~/Desktop/内容创作/01-文章加工厂")
candidates = []
fallback = None
now = time.time()
for sf in glob.glob(os.path.join(factory, "*/.state.json")):
    try:
        d = json.load(open(sf))
        phase = str(d.get("current_phase",""))
        mt = os.path.getmtime(sf)
        if not fallback or mt > os.path.getmtime(fallback):
            fallback = sf
        if phase in ("complete", "done"): continue
        if now - mt < 4*3600:
            candidates.append((mt, sf))
    except: pass
if candidates:
    print(sorted(candidates, reverse=True)[0][1])
elif fallback:
    print(fallback)
PY
}
# 判断是否已完成(phase 到 12, 或 completed 含 '12'/'archive')
is_done() {
  local sf="$1"; [ -f "$sf" ] || return 1
  python3 - "$sf" <<'PY'
import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
ph=str(d.get("current_phase",""))
comp=[str(x) for x in d.get("completed",[])]
# xiaolai-write 终态: phase 12 完成(archive)
sys.exit(0 if ("12" in comp or ph=="done" or ph=="12" and "11" in comp) else 1)
PY
}

CLAUDE_FLAGS=(--mcp-config "$HOME/.claude/mcp-servers/getnote-only.json" --permission-mode bypassPermissions --add-dir "$WORK")
# session-id 每次运行都生成新的(避免同日重跑撞 "already in use")
# 但同一次脚本内的所有 --resume 仍用这个 SID 续上一轮
SID=$(python3 -c "import uuid;print(uuid.uuid4())")
log "本次接力 session-id=$SID"

# 每轮输出临时文件, 用于检测 session limit
RELAY_OUT="$HOME/.claude/logs/.daily-relay-out.txt"

# 检测到用量上限 → 立即止损退出, 留给后续 launchd 时刻(reset 后)重试
hit_session_limit() {
  grep -qiE "session limit|usage limit|hit your .* limit|rate.?limit" "$RELAY_OUT" 2>/dev/null
}

# 第一轮: 启动 xiaolai-write(选题 + 开 pipeline), 用指定 session-id
log "接力第 1 轮: 启动 xiaolai-write..."
echo "$PROMPT" | timeout 1500 "$CLAUDE" -p --session-id "$SID" "${CLAUDE_FLAGS[@]}" > "$RELAY_OUT" 2>&1
cat "$RELAY_OUT" >> "$LOG"
log "  第 1 轮 rc=$? (124=超时)"
if hit_session_limit; then
  log "  撞用量上限, 止损退出, 后续 launchd 时刻(reset 后)自动重试"
  exit 0
fi

# 后续接力: --resume 续跑, 每轮推进几个阶段, 直到完成 / 撞限 / 无进展 / 达上限
CONT_PROMPT="继续推进当前 xiaolai-write 文章的 pipeline,从 .state.json 记录的 current_phase 接着往下跑。完成全部阶段后,按之前的要求把英文版保存到 articles/en/、中文版保存到 articles/zh/(中英互链),运行 python3 .tools/gen_readme.py 重建 README,然后 git add/commit/push。全程不要停下问我。"
MAX_RELAYS=12
PREV_PHASE=""
STALL=0
for r in $(seq 1 $MAX_RELAYS); do
  # 已出双版 → 成功收工
  if ls "$WORK"/articles/en/${TODAY}-*.md >/dev/null 2>&1 && ls "$WORK"/articles/zh/${TODAY}-*.md >/dev/null 2>&1; then
    log "  双版已落地, 接力结束(第 $r 轮前)"; break
  fi
  SF=$(latest_state)
  CUR_PHASE=$(python3 -c "import json;print(json.load(open('$SF')).get('current_phase'))" 2>/dev/null || echo '?')
  # 无进展计数: 连续 2 轮 phase 没动 → 止损(避免空转烧配额)
  if [ "$CUR_PHASE" = "$PREV_PHASE" ]; then STALL=$((STALL+1)); else STALL=0; fi
  PREV_PHASE="$CUR_PHASE"
  if [ "$STALL" -ge 2 ]; then
    log "  连续 $STALL 轮 phase 停滞在 $CUR_PHASE, 止损退出, 等后续触发"
    exit 0
  fi
  log "接力第 $((r+1)) 轮: --resume 续跑... (state phase: $CUR_PHASE)"
  echo "$CONT_PROMPT" | timeout 1200 "$CLAUDE" -p --resume "$SID" "${CLAUDE_FLAGS[@]}" > "$RELAY_OUT" 2>&1
  cat "$RELAY_OUT" >> "$LOG"
  log "  第 $((r+1)) 轮 rc=$?"
  if hit_session_limit; then
    log "  撞用量上限, 止损退出, 后续 launchd 时刻(reset 后)自动重试"
    exit 0
  fi
done
RC=0

# 4. 兜底确认双版是否真的推送了(robust: 处理 ruvector.db 干扰, 只 add 文章相关)
cd "$WORK"
EN_FILE=$(ls articles/en/${TODAY}-*.md 2>/dev/null | head -1)
ZH_FILE=$(ls articles/zh/${TODAY}-*.md 2>/dev/null | head -1)
if [ -n "$EN_FILE" ] && [ -n "$ZH_FILE" ]; then
  log "SUCCESS: 英文=$(basename "$EN_FILE") 中文=$(basename "$ZH_FILE")"
  # 清运行时垃圾, 重建 README, 只提交文章相关文件(不被 ruvector.db 干扰)
  rm -f ruvector.db ./*.db 2>/dev/null
  git rm --cached --ignore-unmatch ruvector.db "*.db" >/dev/null 2>&1 || true
  python3 .tools/gen_readme.py >>"$LOG" 2>&1 || true
  # 先 pull 对齐远端(可能有其他时刻/补丁的 commit)
  for i in 1 2 3; do
    git pull -q --rebase origin main 2>>"$LOG" && break
    [ "$i" -eq 3 ] && { git rebase --abort 2>/dev/null; git fetch -q origin main; git reset --hard origin/main 2>>"$LOG"; }
    rm -f ruvector.db ./*.db 2>/dev/null; sleep $((i*3))
  done
  # 记录今日主题到持久 log(append-only,供未来选题去重;文章日后被删也保留)
  ZH_T=$(head -1 "$ZH_FILE" | sed 's/^#[[:space:]]*//')
  grep -qxF "$ZH_T" .tools/published-topics.log 2>/dev/null || echo "$ZH_T" >> .tools/published-topics.log
  git add articles/ README.md .gitignore .tools/ 2>/dev/null
  if [ -n "$(git diff --cached --name-only)" ]; then
    git commit -q -m "post: ${TODAY} 中英双版" 2>>"$LOG" || true
    for i in 1 2 3; do
      git push -q origin main 2>>"$LOG" && { log "push 成功"; break; }
      log "push 第 $i 次失败"; sleep $((i*5))
    done
  fi
  # 验证远端确有今日文章再标记成功
  if gh api repos/shengdabai/Tony-Articles/contents/articles/zh 2>/dev/null | grep -q "${TODAY}"; then
    touch "$HOME/.claude/logs/.daily-article-done-${TODAY}"
    log "已验证远端含今日中文版, 标记完成"

    # 微信推送改由 daily-digest.sh 统一处理(思考+热点合并成一条, 国内快链)。
    # 结尾顺手调一次(幂等; 两篇未齐会自动跳过, 齐了立即合并推送)。
    bash "$HOME/.claude/scripts/daily-digest.sh" >/dev/null 2>&1 || true
  else
    log "WARN: 远端未确认今日文章, 不标记完成, 后续重试"
  fi
else
  log "ERROR: 今日双版未齐(en=${EN_FILE:-无} zh=${ZH_FILE:-无}), launchd 将稍后重试"
fi

log "===== 任务结束 ====="
