{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/geo-brief.schema.json",
  "title": "GEO Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "brief_id", "subject", "seed_queries"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "brief_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "subject": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "brand": {"type": "string", "pattern": "\\S"},
    "locale": {"type": "string", "pattern": "\\S", "default": "zh-CN"},
    "seed_queries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "audiences": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "competitors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "claim", "source_uri"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "claim": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "source_uri": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$", "format": "uri"},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
