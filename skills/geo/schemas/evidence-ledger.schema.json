{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/evidence-ledger.schema.json",
  "title": "Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "records", "missing_evidence"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "claim", "source_uri", "status"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "\\S"},
          "claim": {"type": "string", "pattern": "\\S"},
          "source_uri": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$", "format": "uri"},
          "status": {"enum": ["provided", "verified", "unverified"]}
        }
      }
    },
    "missing_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
  }
}
