{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/content-spec.schema.json",
  "title": "Content Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "spec_id", "title", "target_query_ids", "required_evidence_ids", "sections", "status"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "spec_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "target_query_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
    "required_evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["heading", "purpose"], "properties": {"heading": {"type": "string", "pattern": "\\S"}, "purpose": {"type": "string", "pattern": "\\S"}}}},
    "status": {"enum": ["draft", "ready", "blocked-by-evidence"]}
  }
}
