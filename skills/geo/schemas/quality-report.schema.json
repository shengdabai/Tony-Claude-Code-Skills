{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/quality-report.schema.json",
  "title": "Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "passed_checks", "warnings", "failed_checks", "status"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "passed_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "failed_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "status": {"enum": ["passed", "passed-with-warnings", "failed"]}
  }
}
