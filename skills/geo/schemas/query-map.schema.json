{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/query-map.schema.json",
  "title": "Query Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "queries"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "question", "intent", "audience", "scenario", "parent_query_id", "rewrites", "evidence_status"],
        "properties": {
          "query_id": {"type": "string", "pattern": "\\S"},
          "question": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "intent": {"enum": ["learn", "compare", "evaluate", "act"]},
          "audience": {"type": "string", "pattern": "\\S"},
          "scenario": {"type": "string", "pattern": "\\S"},
          "parent_query_id": {"type": ["string", "null"], "pattern": "\\S"},
          "rewrites": {
            "type": "object",
            "additionalProperties": false,
            "required": ["standalone", "retrieval", "evidence"],
            "properties": {
              "standalone": {"type": "string", "pattern": "\\S"},
              "retrieval": {"type": "string", "pattern": "\\S"},
              "evidence": {"type": "string", "pattern": "\\S"}
            }
          },
          "evidence_status": {"enum": ["provided", "missing"]}
        }
      }
    }
  }
}
